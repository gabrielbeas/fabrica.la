{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fabrica-admin-auth",
  "main": "src/index.js",
  "no_bundle": true,
  "find_additional_modules": false,
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "fabrica.la/admin*",
      "zone_name": "fabrica.la"
    }
  ],
  "vars": {
    "BASIC_USER": "admin",
    "SHEETS_ENDPOINT": "https://script.google.com/macros/s/AKfycbxDpFEO82dbxRVdS1fS-cSoYdAGC2mAby-6SdVipmG1QjCInBLVgD25k0XZRo7kGMVZ/exec"
  },
  "secrets": {
    "required": ["BASIC_PASSWORD", "SHEETS_ACCESS_TOKEN", "READINGS_ENDPOINT"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
