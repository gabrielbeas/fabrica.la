{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fabrica-admin-auth",
  "main": "src/index.js",
  "no_bundle": true,
  "find_additional_modules": false,
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "fabrica.la/admin*",
      "zone_name": "fabrica.la"
    }
  ],
  "vars": {
    "BASIC_USER": "admin"
  },
  "secrets": {
    "required": ["BASIC_PASSWORD"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
