rules_version = '2';

// Reglas de seguridad de Firestore - La Fábrica de Chocolate
// Copia de referencia: las reglas activas se publican en Firebase Console -> Firestore -> Rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Usuario con perfil en /users y no desactivado
    function isRegistered() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('activo', true) != false;
    }

    function isAdmin() {
      return isRegistered()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    function puedeUsarCajaChica() {
      return isRegistered()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol in ['admin', 'operario'];
    }

    // Perfiles: cada quien lee el suyo; solo el admin ve y modifica todos
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // Agua: catálogo y costo solo los cambia el admin
    match /agua_medidores/{id} {
      allow read: if isRegistered();
      allow write: if isAdmin();
    }
    match /agua_config/{id} {
      allow read: if isRegistered();
      allow write: if isAdmin();
    }
    // Lecturas: cualquier usuario registrado captura; solo el admin borra
    match /agua_lecturas/{id} {
      allow read, create, update: if isRegistered();
      allow delete: if isAdmin();
    }

    // Contratos de locales: datos sensibles (RFC, rentas) -> solo admin
    match /contratos/{id} {
      allow read, write: if isAdmin();
    }
    // Historial de cambios de cada contrato: el admin lo lee y agrega; nadie lo edita ni borra
    match /contratos/{id}/historial/{h} {
      allow read, create: if isAdmin();
    }

    // Facturación: solo admin
    match /facturas/{id} {
      allow read, write: if isAdmin();
    }
    match /facturacion_config/{id} {
      allow read, write: if isAdmin();
    }

    // SIAPA (toma general de la plaza): periodos, recibos y pagos -> solo admin
    match /siapa_periodos/{id} {
      allow read, write: if isAdmin();
    }
    match /siapa_recibos/{id} {
      allow read, write: if isAdmin();
    }
    match /siapa_pagos/{id} {
      allow read, write: if isAdmin();
    }

    // Calendario: cualquier usuario registrado ve y agrega eventos; solo el admin edita y borra
    match /calendario_eventos/{id} {
      allow read, create: if isRegistered();
      allow update, delete: if isAdmin();
    }

    // Caja Chica: admin y operario consultan; operario agrega movimientos y cortes sin editar ni borrar.
    match /caja_chica_config/{id} {
      allow read: if puedeUsarCajaChica();
      allow create, update: if isAdmin()
        && request.resource.data.saldoInicial is number
        && request.resource.data.saldoInicial >= 0
        && request.resource.data.fechaInicio is string;
      allow delete: if false;
    }
    match /caja_chica_movimientos/{id} {
      allow read: if puedeUsarCajaChica();
      allow create: if puedeUsarCajaChica()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.fecha is string
        && request.resource.data.tipo in ['gasto', 'entrada']
        && request.resource.data.categoria is string
        && request.resource.data.descripcion is string
        && request.resource.data.importe is number
        && request.resource.data.importe > 0
        && request.resource.data.estado == (isAdmin() ? 'aprobado' : 'pendiente')
        && request.resource.data.comprobantePath is string
        && (request.resource.data.comprobantePath == '' || request.resource.data.comprobantePath.matches('caja-chica/' + request.auth.uid + '/.*'));
      allow update: if isAdmin()
        && resource.data.estado == 'pendiente'
        && request.resource.data.estado in ['aprobado', 'rechazado']
        && request.resource.data.revisadoPor == request.auth.uid
        && request.resource.data.revisadoEn is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'revisadoPor', 'revisadoPorNombre', 'revisadoEn', 'notaRevision']);
      allow delete: if false;

      match /historial/{eventoId} {
        allow read: if puedeUsarCajaChica();
        allow create: if isAdmin()
          && request.resource.data.registradoPor == request.auth.uid
          && request.resource.data.accion in ['aprobado', 'rechazado'];
        allow update, delete: if false;
      }
    }
    match /caja_chica_cortes/{id} {
      allow read: if puedeUsarCajaChica();
      allow create: if puedeUsarCajaChica()
        && request.resource.data.registradoPor == request.auth.uid
        && request.resource.data.fecha is string
        && request.resource.data.saldoEsperado is number
        && request.resource.data.efectivoContado is number
        && request.resource.data.diferencia is number;
      allow update, delete: if false;
    }

    // Resto de colecciones: usuarios registrados
    match /{collection}/{docId} {
      allow read, write: if !(collection in ['users', 'agua_medidores', 'agua_config', 'agua_lecturas', 'contratos', 'facturas', 'facturacion_config', 'calendario_eventos', 'caja_chica_config', 'caja_chica_movimientos', 'caja_chica_cortes', 'siapa_periodos', 'siapa_recibos', 'siapa_pagos']) && isRegistered();
    }
    match /{collection}/{docId}/{rest=**} {
      allow read, write: if !(collection in ['users', 'agua_medidores', 'agua_config', 'agua_lecturas', 'contratos', 'facturas', 'facturacion_config', 'calendario_eventos', 'caja_chica_config', 'caja_chica_movimientos', 'caja_chica_cortes', 'siapa_periodos', 'siapa_recibos', 'siapa_pagos']) && isRegistered();
    }
  }
}
