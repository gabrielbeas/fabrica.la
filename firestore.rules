rules_version = '2';

// Reglas de seguridad de Firestore - La Fábrica de Chocolate
// Copia de referencia: las reglas activas se publican en Firebase Console -> Firestore -> Rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Responsables: «Victor Navaro» es la grafía anterior (registros previos al 04/10/2026); el panel ya solo ofrece «Victor Navarro».

    function signedIn() {
      return request.auth != null;
    }

    // Usuario con perfil en /users y no desactivado
    function isRegistered() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('activo', true) != false;
    }

    function isAdmin() {
      return isRegistered()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    function esOperario() {
      return isRegistered()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'operario';
    }

    function puedeUsarCajaChica() {
      return isRegistered()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol in ['admin', 'operario'];
    }

    // Perfiles: cada quien lee el suyo; solo el admin ve y modifica todos
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // Agua: catálogo y costo solo los cambia el admin
    match /agua_medidores/{id} {
      allow read: if isRegistered();
      allow write: if isAdmin();
    }
    match /agua_config/{id} {
      allow read: if isRegistered();
      allow write: if isAdmin();
    }
    // Lecturas: el admin captura, corrige y borra cualquiera.
    // El operario captura lecturas nuevas y corrige solo las que él capturó, durante 24 h;
    // el costo por m³ tiene que ser el vigente en agua_config/general y no puede cambiar la autoría.
    match /agua_lecturas/{id} {
      function lecturaValida() {
        return request.resource.data.tubo is string
          && request.resource.data.fecha is string
          && request.resource.data.fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && id == request.resource.data.tubo + '_' + request.resource.data.fecha
          && request.resource.data.lectura is number
          && request.resource.data.costoM3 == get(/databases/$(database)/documents/agua_config/general).data.costoM3;
      }
      allow read: if isRegistered();
      allow create: if isAdmin()
        || (esOperario()
          && lecturaValida()
          && request.resource.data.capturadoPorUid == request.auth.uid
          && request.resource.data.capturadoEn == request.time);
      allow update: if isAdmin()
        || (esOperario()
          && lecturaValida()
          && resource.data.capturadoPorUid == request.auth.uid
          && request.time < resource.data.capturadoEn + duration.value(24, 'h')
          && request.resource.data.capturadoPorUid == resource.data.capturadoPorUid
          && request.resource.data.capturadoEn == resource.data.capturadoEn);
      allow delete: if isAdmin();
    }

    // Contratos de locales: datos sensibles (RFC, rentas) -> solo admin
    match /contratos/{id} {
      allow read, write: if isAdmin();
    }
    // Historial de cambios de cada contrato: el admin lo lee y agrega; nadie lo edita ni borra
    match /contratos/{id}/historial/{h} {
      allow read, create: if isAdmin();
    }

    // Facturación: solo admin
    match /facturas/{id} {
      allow read, write: if isAdmin();
    }
    match /facturacion_config/{id} {
      allow read, write: if isAdmin();
    }

    // SIAPA (toma general de la plaza): periodos, recibos y pagos -> solo admin
    match /siapa_periodos/{id} {
      allow read, write: if isAdmin();
    }
    match /siapa_recibos/{id} {
      allow read, write: if isAdmin();
    }
    match /siapa_pagos/{id} {
      allow read, write: if isAdmin();
    }

    // Calendario: admin y operario ven y agregan eventos (firmados con su correo).
    // El admin edita y borra cualquiera; el operario solo los que él capturó.
    match /calendario_eventos/{id} {
      allow read: if isRegistered();
      allow create: if isRegistered()
        && request.resource.data.creadoPor == request.auth.token.email;
      allow update: if isAdmin()
        || (esOperario()
          && resource.data.creadoPor == request.auth.token.email
          && request.resource.data.creadoPor == resource.data.creadoPor);
      allow delete: if isAdmin()
        || (esOperario() && resource.data.creadoPor == request.auth.token.email);
    }

    // Caja Chica: admin y operario consultan; operario agrega movimientos y cortes sin editar ni borrar.
    match /caja_chica_config/{id} {
      allow read: if puedeUsarCajaChica();
      allow create, update: if isAdmin()
        && request.resource.data.saldoInicial is number
        && request.resource.data.saldoInicial >= 0
        && request.resource.data.fechaInicio is string;
      allow delete: if false;
    }
    match /caja_chica_movimientos/{id} {
      function edicionValida() {
        return request.resource.data.estado == resource.data.estado
          && request.resource.data.editadoPor == request.auth.uid
          && request.resource.data.editadoEn is timestamp
          && request.resource.data.ultimaEdicionHistorialId is string
          && request.resource.data.fecha is string
          && request.resource.data.tipo in ['gasto', 'entrada']
          && request.resource.data.categoria is string
          && request.resource.data.responsable in ['Claudio Del Angel', 'Victor Navarro', 'Victor Navaro', 'Admin LAFABDECHOC']
          && request.resource.data.proveedor is string
          && request.resource.data.descripcion is string
          && request.resource.data.importe is number
          && request.resource.data.importe > 0
          && request.resource.data.comprobantePath is string
          && (request.resource.data.comprobantePath == resource.data.comprobantePath || request.resource.data.comprobantePath.matches('caja-chica/' + request.auth.uid + '/.*'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tipo', 'fecha', 'importe', 'descripcion', 'categoria', 'responsable', 'proveedor', 'metodoPago', 'comprobantePath', 'comprobanteNombre', 'comprobanteTipo', 'comprobanteBytes', 'editadoPor', 'editadoEn', 'ultimaEdicionHistorialId'])
          && !exists(/databases/$(database)/documents/caja_chica_movimientos/$(id)/historial/$(request.resource.data.ultimaEdicionHistorialId))
          && existsAfter(/databases/$(database)/documents/caja_chica_movimientos/$(id)/historial/$(request.resource.data.ultimaEdicionHistorialId))
          && getAfter(/databases/$(database)/documents/caja_chica_movimientos/$(id)/historial/$(request.resource.data.ultimaEdicionHistorialId)).data.accion == 'editado'
          && getAfter(/databases/$(database)/documents/caja_chica_movimientos/$(id)/historial/$(request.resource.data.ultimaEdicionHistorialId)).data.registradoPor == request.auth.uid;
      }
      allow read: if puedeUsarCajaChica();
      allow create: if puedeUsarCajaChica()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.fecha is string
        && request.resource.data.tipo in ['gasto', 'entrada']
        && request.resource.data.categoria is string
        && request.resource.data.responsable in ['Claudio Del Angel', 'Victor Navarro', 'Victor Navaro', 'Admin LAFABDECHOC']
        && request.resource.data.proveedor is string
        && request.resource.data.descripcion is string
        && request.resource.data.importe is number
        && request.resource.data.importe > 0
        && request.resource.data.estado == (isAdmin() ? 'aprobado' : 'pendiente')
        && request.resource.data.comprobantePath is string
        && (request.resource.data.comprobantePath == '' || request.resource.data.comprobantePath.matches('caja-chica/' + request.auth.uid + '/.*'));
      allow update: if (isAdmin()
          && resource.data.estado == 'pendiente'
          && request.resource.data.estado in ['aprobado', 'rechazado']
          && request.resource.data.revisadoPor == request.auth.uid
          && request.resource.data.revisadoEn is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'revisadoPor', 'revisadoPorNombre', 'revisadoEn', 'notaRevision']))
        || ((isAdmin()
          || (puedeUsarCajaChica() && resource.data.creadoPor == request.auth.uid && resource.data.estado == 'pendiente'))
          && edicionValida());
      allow delete: if false;

      match /historial/{eventoId} {
        allow read: if puedeUsarCajaChica();
        allow create: if (isAdmin()
            && request.resource.data.registradoPor == request.auth.uid
            && request.resource.data.accion in ['aprobado', 'rechazado'])
          || ((isAdmin() || (puedeUsarCajaChica()
            && getAfter(/databases/$(database)/documents/caja_chica_movimientos/$(id)).data.creadoPor == request.auth.uid
            && getAfter(/databases/$(database)/documents/caja_chica_movimientos/$(id)).data.estado == 'pendiente'))
            && request.resource.data.accion == 'editado'
            && request.resource.data.registradoPor == request.auth.uid
            && getAfter(/databases/$(database)/documents/caja_chica_movimientos/$(id)).data.ultimaEdicionHistorialId == eventoId
            && getAfter(/databases/$(database)/documents/caja_chica_movimientos/$(id)).data.editadoPor == request.auth.uid);
        allow update, delete: if false;
      }
    }
    match /caja_chica_cortes/{id} {
      allow read: if puedeUsarCajaChica();
      allow create: if puedeUsarCajaChica()
        && request.resource.data.registradoPor == request.auth.uid
        && request.resource.data.fecha is string
        && request.resource.data.saldoEsperado is number
        && request.resource.data.efectivoContado is number
        && request.resource.data.diferencia is number;
      allow update, delete: if false;
    }

    // Bitácora: admin y operario consultan y registran; el operario corrige sus registros
    // durante 24 h; el admin corrige y elimina cualquiera. Cada corrección deja historial;
    // al eliminar, el panel guarda una copia en bitacora_eliminados (cubierta por la regla general: solo admin).
    match /bitacora/{id} {
      function camposValidos() {
        return request.resource.data.fecha is string
          && request.resource.data.fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.hora is string
          && request.resource.data.categoria in ['Limpieza', 'Mantenimiento', 'Mantenimiento preventivo', 'Bombas y cisterna', 'Agua', 'Electricidad', 'Seguridad', 'Basura y recolección', 'Jardinería', 'Proveedor o servicio externo', 'Atención a locatario', 'Otro']
          && request.resource.data.lugar is string
          && request.resource.data.accion is string
          && request.resource.data.accion.size() > 0
          && request.resource.data.accion.size() <= 160
          && request.resource.data.detalle is string
          && request.resource.data.detalle.size() <= 1500
          && request.resource.data.responsable in ['Claudio Del Angel', 'Victor Navarro', 'Victor Navaro', 'Admin LAFABDECHOC']
          && request.resource.data.fotos is list
          && request.resource.data.fotos.size() <= 3;
      }
      allow read: if puedeUsarCajaChica();
      allow create: if puedeUsarCajaChica()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.keys().hasOnly(['fecha', 'hora', 'categoria', 'lugar', 'accion', 'detalle', 'responsable', 'fotos', 'creadoPor', 'registradoPorNombre', 'creadoEn'])
        && camposValidos();
      allow update: if (isAdmin()
          || (puedeUsarCajaChica()
            && resource.data.creadoPor == request.auth.uid
            && request.time < resource.data.creadoEn + duration.value(24, 'h')))
        && camposValidos()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fecha', 'hora', 'categoria', 'lugar', 'accion', 'detalle', 'responsable', 'fotos', 'editadoPor', 'editadoPorNombre', 'editadoEn', 'ultimaEdicionHistorialId'])
        && request.resource.data.editadoPor == request.auth.uid
        && request.resource.data.editadoEn == request.time
        && !exists(/databases/$(database)/documents/bitacora/$(id)/historial/$(request.resource.data.ultimaEdicionHistorialId))
        && existsAfter(/databases/$(database)/documents/bitacora/$(id)/historial/$(request.resource.data.ultimaEdicionHistorialId));
      allow delete: if isAdmin();

      match /historial/{eventoId} {
        allow read: if puedeUsarCajaChica();
        allow create: if puedeUsarCajaChica()
          && request.resource.data.accion == 'editado'
          && request.resource.data.registradoPor == request.auth.uid
          && getAfter(/databases/$(database)/documents/bitacora/$(id)).data.ultimaEdicionHistorialId == eventoId
          && getAfter(/databases/$(database)/documents/bitacora/$(id)).data.editadoPor == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Resto de colecciones (las que no tienen regla propia arriba): solo admin.
    // El operario solo usa agua (lecturas, medidores, costo), calendario, caja chica y bitácora, que tienen su regla propia.
    // La lista excluye las colecciones con regla propia para no ampliar sus permisos (p. ej. historiales y caja chica).
    match /{collection}/{docId} {
      allow read, write: if !(collection in ['users', 'agua_medidores', 'agua_config', 'agua_lecturas', 'contratos', 'facturas', 'facturacion_config', 'calendario_eventos', 'caja_chica_config', 'caja_chica_movimientos', 'caja_chica_cortes', 'siapa_periodos', 'siapa_recibos', 'siapa_pagos', 'bitacora']) && isAdmin();
    }
    match /{collection}/{docId}/{rest=**} {
      allow read, write: if !(collection in ['users', 'agua_medidores', 'agua_config', 'agua_lecturas', 'contratos', 'facturas', 'facturacion_config', 'calendario_eventos', 'caja_chica_config', 'caja_chica_movimientos', 'caja_chica_cortes', 'siapa_periodos', 'siapa_recibos', 'siapa_pagos', 'bitacora']) && isAdmin();
    }
  }
}
